# ---- server ----
PORT=5055
HOST=0.0.0.0
# Absolute origin this server is reachable at. Used to build install snippets
# and as the allowlist for admin mutations, so set it correctly in production.
PUBLIC_BASE_URL=http://localhost:5055

# ---- database ----
# Zero-infrastructure default: embedded Postgres (PGlite) in apps/server/.data/pg.
# `pglite:memory` discards data on exit. Development only.
DATABASE_URL=pglite:.data/pg
# Real Postgres, matching docker-compose.yml (host port 5433 so it does not clash
# with a local Postgres). Use this shape in production.
# DATABASE_URL=postgresql://webplugins:webplugins@localhost:5433/webplugins

# ---- secrets (change these) ----
# Signs the admin session cookie. 16 characters minimum.
SESSION_SECRET=dev-session-secret-change-me-32-chars-min
# Signs short-lived preview tokens so the panel can render unpublished drafts.
PREVIEW_TOKEN_SECRET=dev-preview-secret-change-me-32-chars-min

# ---- admin login (single tenant self-host) ----
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin

# ---- optional ----
# Serve the runtime bundle from a CDN instead of this server.
RUNTIME_BUNDLE_URL=
# Base URL of an identity/session service. Leave empty to disable visitor
# identity and event tracking in the runtime (the chat module is not in v1).
IDENTITY_BASE_URL=

# ---- widget hosts used when seeding templates ----
# Each template's `src` is read from here, so a deploy can point the starter
# widgets at its own hosts without editing code.
HELLO_WIDGET_URL=http://localhost:5174/
SUPPORT_CLIENT_URL=
POPUP_CLIENT_URL=
REWARDS_CLIENT_URL=
