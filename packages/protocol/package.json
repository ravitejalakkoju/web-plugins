{
  "name": "@web-plugins/protocol",
  "version": "0.1.0",
  "description": "Shared config schema, RPC envelope and health contracts for Web Plugins",
  "license": "MIT",
  "author": "Ravi Teja L",
  "homepage": "https://github.com/ravitejalakkoju/web-plugins/tree/main/packages/protocol#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ravitejalakkoju/web-plugins.git",
    "directory": "packages/protocol"
  },
  "bugs": {
    "url": "https://github.com/ravitejalakkoju/web-plugins/issues"
  },
  "keywords": [
    "config",
    "json-schema",
    "widget",
    "embed",
    "rpc"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./rpc": {
      "types": "./dist/rpc/index.d.ts",
      "import": "./dist/rpc/index.js",
      "require": "./dist/rpc/index.cjs"
    },
    "./config": {
      "types": "./dist/config/index.d.ts",
      "import": "./dist/config/index.js",
      "require": "./dist/config/index.cjs"
    },
    "./health": {
      "types": "./dist/health/index.d.ts",
      "import": "./dist/health/index.js",
      "require": "./dist/health/index.cjs"
    },
    "./form": {
      "types": "./dist/form/index.d.ts",
      "import": "./dist/form/index.js",
      "require": "./dist/form/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "prepublishOnly": "pnpm run build",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1"
  },
  "devDependencies": {
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  }
}
