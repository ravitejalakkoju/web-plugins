{
  "name": "@web-plugins/server",
  "version": "0.1.0",
  "description": "Web Plugins control plane: config API, health, and the SSR admin panel",
  "license": "AGPL-3.0-only",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/main.ts",
    "start": "node --env-file-if-exists=../../.env dist/main.js",
    "build": "vite build && vite build --ssr entry-server.tsx --outDir ../dist/admin/server && tsup",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=../../.env src/db/migrate.ts",
    "db:seed": "tsx --env-file-if-exists=../../.env src/db/seed.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "^11.3.0",
    "@fastify/middie": "^9.3.4",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/static": "^10.1.4",
    "@web-plugins/protocol": "workspace:*",
    "@web-plugins/runtime": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.12.5",
    "jose": "^6.2.12",
    "pg": "^8.23.0",
    "preact": "^10.29.8",
    "preact-render-to-string": "^6.7.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@preact/preset-vite": "^2.10.6",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.2",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.10",
    "pino-pretty": "^13.1.3",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "tsup": "^8.5.1",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "vite": "^8.3.0"
  }
}
